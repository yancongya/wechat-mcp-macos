{
  "version": 1,
  "comment": "Prompt registry — 按 trigger 匹配 chat/contact 输出不同 prompt",

  "defaults": {
    "hours": 0,
    "max_messages": 10000,
    "output": {
      "image_style": {
        "width": 800
      }
    }
  },

  "prompts": [
    {
      "id": "langze-daily",
      "name": "琅泽群每日总结",
      "description": "琅泽 BL/几何节点群的 AI 总结 + 长图",
      "trigger": {
        "type": "group",
        "chats": [
          "58299288465@chatroom",
          "48672694909@chatroom"
        ]
      },
      "input": {
        "source": "pipeline",
        "pipeline_args": {
          "hours": 0,
          "limit": 1200,
          "voice_engine": "whisper"
        }
      },
      "process": {
        "mode": "llm",
        "template_file": "group-summary-image-json.txt"
      },
      "output": {
        "text": true,
        "image": true
      }
    },

    {
      "id": "any-group-summary",
      "name": "通用群聊总结",
      "description": "任意群聊的日期区间总结，默认输出文字和图片",
      "trigger": {
        "type": "group",
        "chats": []
      },
      "input": {
        "source": "range-query",
        "pipeline_args": {
          "hours": 0,
          "limit": 10000
        }
      },
      "process": {
        "mode": "llm",
        "template_file": "chat-summary-image-json.txt"
      },
      "output": {
        "text": true,
        "json": true,
        "image": true
      }
    },

    {
      "id": "any-contact-summary",
      "name": "通用私聊总结",
      "description": "任意私聊的日期区间总结，默认输出文字和图片",
      "trigger": {
        "type": "contact",
        "contacts": []
      },
      "input": {
        "source": "range-query",
        "pipeline_args": {
          "hours": 0,
          "limit": 10000
        }
      },
      "process": {
        "mode": "llm",
        "template_file": "chat-summary-image-json.txt"
      },
      "output": {
        "text": true,
        "json": true,
        "image": true
      }
    },

    {
      "id": "default",
      "name": "兜底处理",
      "description": "无法识别 chat 类型时的最后兜底",
      "trigger": {
        "type": "catchall"
      },
      "input": {
        "source": "raw",
        "pipeline_args": {
          "hours": 0
        }
      },
      "process": {
        "mode": "llm",
        "template_file": "chat-summary-image-json.txt"
      },
      "output": {
        "text": true,
        "image": true
      }
    }
  ]
}
